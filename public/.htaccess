# Hostinger (LiteSpeed/Apache): rotas do Angular.
# Arquivos e pastas que existem (assets, /modelos/...) são servidos normalmente;
# qualquer outra rota (/servicos, /portfolio...) recebe o index.html e o Angular resolve.
# Sem isto, dar F5 em https://ionext.com.br/servicos devolve 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ /index.html [L]
</IfModule>

# O index.html nunca fica em cache: cada publicação aparece na hora.
# Os .js/.css do Angular têm hash no nome e podem ficar em cache.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>

# Desempenho (não muda nada visualmente):
# - compressão gzip dos textos (JS, CSS, HTML, SVG, JSON);
# - arquivos com hash no nome (main-XXXX.js, chunk-XXXX.js, styles-XXXX.css e as
#   fontes em media/) nunca mudam de conteúdo: cache de 1 ano, sem revalidar;
# - imagens e vídeos: 7 dias.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(main|chunk|polyfills|styles)-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "-[A-Z0-9]{8}\.(woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
