# Hostinger (LiteSpeed/Apache): rotas do Angular.
# Arquivos e pastas que existem (assets, /modelos/...) são servidos normalmente;
# qualquer outra rota (/servicos, /portfolio...) recebe o index.html e o Angular resolve.
# Sem isto, dar F5 em https://ionext.com.br/servicos devolve 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ /index.html [L]
</IfModule>

# O index.html nunca fica em cache: cada publicação aparece na hora.
# Os .js/.css do Angular têm hash no nome e podem ficar em cache.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>
